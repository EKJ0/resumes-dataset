@'
# Python-generated files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets and environment variables
.env
.env.*
!.env.example
credentials.json
secrets.json
*.key
*.pem

# Local editor configuration
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Local AI-agent configuration
.agents/

# Operating-system files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Temporary files
*.log
*.tmp
*.temp
*.bak
~$*
'@ | Set-Content -Encoding UTF8 .gitignore